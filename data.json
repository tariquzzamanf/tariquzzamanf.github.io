  "pages": {
    "index": {
      "layout": "home",
      "title": "Md. Tariquzzaman - CSE Lecturer and NLP Researcher at IUT",
      "description": "Official academic website of Md. Tariquzzaman, Junior Lecturer in Computer Science and Engineering at Islamic University of Technology (IUT), with research in NLP, Bangla NLP, misinformation detection, sign language instruction generation, and LLM evaluation.",
      "canonical": "https://tariquzzamanf.github.io/",
      "sections": [
        {
          "type": "prose",
          "icon": "user",
          "eyebrow": "About me",
          "justify": true,
          "lead": "I work on natural language processing for low-resource settings&#8212;Bangla first&#8212;building the embeddings, datasets, and evaluations that make under-served languages and under-served users measurable.",
          "paragraphs": [
            "I am a <a href=\"https://cse.iutoic-dhaka.edu/profile/tariquzzaman/education\" target=\"_blank\" rel=\"noopener\"><strong>Junior Lecturer</strong></a> in the Department of Computer Science and Engineering at the <a href=\"https://www.iutoic-dhaka.edu/\" target=\"_blank\" rel=\"noopener\">Islamic University of Technology (IUT)</a>, and an active member of the <a href=\"https://cse.iutoic-dhaka.edu/ssl\" target=\"_blank\" rel=\"noopener\">Systems and Software Lab (SSL)</a>. I wrote my undergraduate thesis under the supervision of <a href=\"https://cse.iutoic-dhaka.edu/profile/mohsinul/education\" target=\"_blank\" rel=\"noopener\">Mohsinul Kabir</a>, and I am pursuing my graduate studies under the supervision of <a href=\"https://cse.iutoic-dhaka.edu/profile/hasan/education\" target=\"_blank\" rel=\"noopener\">Hasan Mahmud</a>. My work spans low-resource language processing for Bangla, harmful content and misinformation detection, sign language instruction generation, and benchmarking scenario-induced bias in large language models. My open releases include the informal Bangla FastText embedding, the BdSLIG sign language dataset, and the BDA augmentation framework."
          ],
